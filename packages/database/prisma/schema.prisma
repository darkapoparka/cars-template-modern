  dealerOrg        DealerOrg?          @relation(fields: [dealerOrgId], references: [id], onDelete: Restrict)
  sellerProfile    SellerProfile?      @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  actorAccount     MarketplaceAccount? @relation("EntitlementUsageActor", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([dealerOrgId, featureKey, periodStart, periodEnd], map: "EntitlementUsageEvent_dealer_feature_period_idx")
  @@index([sellerProfileId, featureKey, periodStart, periodEnd], map: "EntitlementUsageEvent_seller_feature_period_idx")
  @@index([grantId, createdAt])
  @@index([sourceEntityType, sourceEntityId])
}

model ListingPromotion {
  id                        String                      @id @default(cuid())
  listingId                 String?
  dealerOrgId               String
  billingAccountId          String
  productKey                String
  placement                 PromotionPlacement
  status                    PromotionStatus             @default(scheduled)
  paymentStatus             PromotionPaymentStatus      @default(unpaid)
  cancellationStatus        PromotionCancellationStatus @default(not_requested)
  amountMinor               Int
  refundAmountMinor         Int                         @default(0)
  currency                  PriceCurrency
  idempotencyKey            String?                     @unique
  providerCheckoutSessionId String?                     @unique
  providerPaymentIntentId   String?                     @unique
  activatedByEventId        String?                     @unique
  listingTitleSnapshot      String
  disclosureLabel           String                      @default("Promoted")
  startsAt                  DateTime
  endsAt                    DateTime
  activatedAt               DateTime?
  canceledAt                DateTime?
  endedAt                   DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  listing                   MarketplaceListing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  dealerOrg                 DealerOrg                   @relation(fields: [dealerOrgId], references: [id], onDelete: Restrict)
  billingAccount            DealerBillingAccount        @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  events                    ListingPromotionEvent[]

  @@index([dealerOrgId, status, startsAt])
  @@index([listingId, status, endsAt])
  @@index([placement, status, startsAt, endsAt])
  @@index([paymentStatus, cancellationStatus, updatedAt])
}

model ListingPromotionEvent {
  id                String                  @id @default(cuid())
  promotionId       String
  dealerOrgId       String
  eventType         PromotionEventType
  idempotencyKey    String                  @unique
  providerEventId   String?                 @unique
  actorAccountId    String?
  fromStatus        PromotionStatus?
  toStatus          PromotionStatus?
  fromPaymentStatus PromotionPaymentStatus?
  toPaymentStatus   PromotionPaymentStatus?
  metadata          Json?
  occurredAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  promotion         ListingPromotion        @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  dealerOrg         DealerOrg               @relation(fields: [dealerOrgId], references: [id], onDelete: Restrict)
  actorAccount      MarketplaceAccount?     @relation("PromotionEventActor", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([promotionId, occurredAt])
  @@index([dealerOrgId, occurredAt])
  @@index([eventType, occurredAt])
}
