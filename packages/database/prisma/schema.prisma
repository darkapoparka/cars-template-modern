model MarketplaceAccount {
  id                       String                              @id @default(cuid())
  clerkUserId              String                              @unique
  status                   AccountStatus                       @default(active)
  deletedAt                DateTime?
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt
  sellerProfile            SellerProfile?
  dealerMemberships        DealerMember[]
  createdListings          MarketplaceListing[]                @relation("ListingCreator")
  listingStatusEvents      ListingStatusEvent[]                @relation("StatusEventActor")
  priceSnapshots           ListingPriceSnapshot[]              @relation("PriceSnapshotActor")
  uploadSessions           MediaUploadSession[]
  uploadedImages           MarketplaceListingImage[]           @relation("ImageUploader")
  photoJobs                ListingPhotoJob[]                   @relation("PhotoJobActor")
  listingGenerations       ListingGeneration[]                 @relation("GenerationActor")
  vinDecodeJobs            ListingVinDecodeJob[]               @relation("VinJobActor")
  reviewedSupplierTrust    SupplierTrustReview[]               @relation("SupplierReviewReviewer")
  reviewedListingTrust     ListingTrustEvidence[]              @relation("ListingEvidenceReviewer")
  reportedModeration       ModerationReport[]                  @relation("ModerationReporter")
  assignedModeration       ModerationReport[]                  @relation("ModerationAssignee")
  buyerLeads               Lead[]                              @relation("LeadBuyer")
  conversationParticipants ConversationParticipant[]
  savedListings            SavedListing[]
  savedSearches            SavedSearch[]
  savedSearchDeliveries    SavedSearchDelivery[]
  auditEntries             AuditLog[]                          @relation("AuditActor")
  clerkOrgProvisionings    ClerkOrgProvisioning[]
  legalEntitiesUpdated     OrganizationLegalEntity[]           @relation("LegalEntityUpdater")
  kybCasesSubmitted        OrganizationKybCase[]               @relation("KybCaseSubmitter")
  kybCasesAssigned         OrganizationKybCase[]               @relation("KybCaseAssignee")
  kybUploadSessions        KybDocumentUploadSession[]
  kybDocumentsUploaded     KybDocument[]                       @relation("KybDocumentUploader")
  kybDecisionsReviewed     KybReviewDecision[]                 @relation("KybDecisionReviewer")
  verificationEvents       OrganizationVerificationEvent[]     @relation("VerificationEventActor")
  inventoryMappingsCreated InventoryCsvMappingVersion[]
  inventoryImportsCreated  InventoryImportSession[]
  directoryClaimsSubmitted OrganizationDirectoryClaimRequest[] @relation("DirectoryClaimApplicant")
  directoryClaimsReviewed  OrganizationDirectoryClaimRequest[] @relation("DirectoryClaimReviewer")
  directoryDraftsUpdated   OrganizationDirectoryProfileDraft[] @relation("DirectoryDraftUpdater")
  entitlementGrantsCreated EntitlementGrant[]                  @relation("EntitlementGrantCreator")
  entitlementUsageEvents   EntitlementUsageEvent[]             @relation("EntitlementUsageActor")
  promotionEvents          ListingPromotionEvent[]             @relation("PromotionEventActor")

  @@index([status, deletedAt])
}

model SellerProfile {
  id                 String                  @id @default(cuid())
  accountId          String?                 @unique
  status             SellerProfileStatus     @default(active)
  displayName        String
  city               String
  region             String?
  country            String                  @default("Bulgaria")
  verificationStatus VerificationStatus      @default(unverified)
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  account            MarketplaceAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  listings           MarketplaceListing[]
  leads              Lead[]
  conversations      Conversation[]
  supplierTrust      SupplierTrustReview[]
  entitlementGrants  EntitlementGrant[]
  entitlementUsage   EntitlementUsageEvent[]

  @@index([status, updatedAt])
  @@index([verificationStatus, updatedAt])
  @@index([city])
}

model DealerOrg {
  id                            String                              @id @default(cuid())
  slug                          String                              @unique
  clerkOrgId                    String                              @unique
  orgType                       DealerOrgType                       @default(dealer)
  legalName                     String?
  displayName                   String
  logoUrl                       String?
  brandColor                    String?
  backdropPreset                String?
  addressLine1                  String?
  addressLine2                  String?
  city                          String?
  region                        String?
  country                       String?
  countryCode                   String?                             @db.Char(2)
  registrationCountryCode       String?                             @db.Char(2)
  registrationNumber            String?
  vatId                         String?
  eoriNumber                    String?
  defaultLocale                 String                              @default("en")
  defaultCurrencyCode           String                              @default("EUR") @db.Char(3)
  timeZone                      String                              @default("UTC")
  onboardingStatus              OrganizationOnboardingStatus        @default(registered)
  kybStatus                     OrganizationKybStatus               @default(not_started)
  kybVerifiedAt                 DateTime?
  kybExpiresAt                  DateTime?
  profileCompletedAt            DateTime?
  phone                         String?
  email                         String?
  websiteUrl                    String?
  websiteFeedEnabled            Boolean                             @default(false)
  verificationStatus            VerificationStatus                  @default(pending)
  subscriptionStatus            DealerSubscriptionStatus            @default(trialing)
  currentKybCaseId              String?                             @unique
  currentVerificationGrantId    String?                             @unique
  verificationProjectionVersion Int                                 @default(0)
  verificationProjectionEventId String?
  verificationProjectionHash    String?
  verificationProjectedAt       DateTime?
  clerkProviderUpdatedAt        DateTime?
  clerkLastSyncedAt             DateTime?
  clerkDeletedAt                DateTime?
  deletedAt                     DateTime?
  createdAt                     DateTime                            @default(now())
  updatedAt                     DateTime                            @updatedAt
  members                       DealerMember[]
  listings                      MarketplaceListing[]
  listingStatusEvents           ListingStatusEvent[]                @relation("StatusEventDealer")
  leads                         Lead[]
  conversations                 Conversation[]
  uploadSessions                MediaUploadSession[]
  listingGenerations            ListingGeneration[]
  photoJobs                     ListingPhotoJob[]
  vinDecodeJobs                 ListingVinDecodeJob[]
  supplierTrust                 SupplierTrustReview[]
  billingAccount                DealerBillingAccount?
  promotions                    ListingPromotion[]
  promotionEvents               ListingPromotionEvent[]
  entitlementGrants             EntitlementGrant[]
  entitlementUsage              EntitlementUsageEvent[]
  auditEntries                  AuditLog[]
  capabilities                  DealerOrgCapability[]
  marketPermissions             OrganizationMarketPermission[]
  inventorySources              InventorySource[]
  sourceInventoryRecords        SourceInventoryRecord[]
  inventoryRightsGrants         InventoryRightsGrant[]
  inventoryOffers               InventoryOffer[]
  marketPublications            MarketPublication[]
  legalEntity                   OrganizationLegalEntity?
  kybCases                      OrganizationKybCase[]               @relation("KybCaseOrganization")
  currentKybCase                OrganizationKybCase?                @relation("CurrentKybCase", fields: [currentKybCaseId, id], references: [id, dealerOrgId], onDelete: Restrict)
  kybUploadSessions             KybDocumentUploadSession[]
  kybDocuments                  KybDocument[]
  kybProviderChecks             KybProviderCheck[]
  kybReviewDecisions            KybReviewDecision[]
  verificationGrants            OrganizationVerificationGrant[]     @relation("VerificationGrantOrganization")
  currentVerificationGrant      OrganizationVerificationGrant?      @relation("CurrentVerificationGrant", fields: [currentVerificationGrantId, id], references: [id, dealerOrgId], onDelete: Restrict)
  verificationEvents            OrganizationVerificationEvent[]
  verificationProjectionEvent   OrganizationVerificationEvent?      @relation("VerificationProjectionEvent", fields: [verificationProjectionEventId, id], references: [id, dealerOrgId], onDelete: Restrict, map: "DealerOrg_verificationProjectionEventId_fkey")
  inventoryCredentialBindings   InventorySourceCredentialBinding[]
  inventoryMappings             InventoryCsvMappingVersion[]
  inventoryImportSessions       InventoryImportSession[]
  inventoryImportArtifacts      InventoryImportArtifact[]
  inventoryImportPreviews       InventoryImportPreview[]
  directoryEntry                OrganizationDirectoryEntry?
  directoryClaims               OrganizationDirectoryClaimRequest[]

  @@unique([currentKybCaseId, id])
  @@unique([currentVerificationGrantId, id])
  @@index([orgType, verificationStatus])
  @@index([city, orgType])
  @@index([deletedAt])
}

model OrganizationDirectoryEntry {
  id                        String                              @id @default(cuid())
  slug                      String                              @unique
  dealerOrgId               String?                             @unique
  orgType                   DealerOrgType
  status                    OrganizationDirectoryStatus         @default(draft)
  claimStatus               OrganizationDirectoryClaimStatus    @default(unclaimed)
  sourceKind                OrganizationDirectorySourceKind     @default(first_party)
  displayName               String
  legalName                 String?
  headline                  String?
  description               String?
  logoUrl                   String?
  profileImageUrl           String?
  websiteUrl                String?
  phone                     String?
  email                     String?
  city                      String?
  region                    String?
  country                   String?
  headquartersCountryCode   String?                             @db.Char(2)
  vehicleCategories         VehicleCategory[]                   @default([])
  services                  String[]                            @default([])
  sourceUrl                 String?
  sourceCheckedAt           DateTime?
  inventoryLastConfirmedAt  DateTime?
  inventoryLocalCount       Int                                 @default(0)
  inventoryInTransitCount   Int                                 @default(0)
  inventorySourceStockCount Int                                 @default(0)
  inventoryOrderableCount   Int                                 @default(0)
  publishedAt               DateTime?
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt
  dealerOrg                 DealerOrg?                          @relation(fields: [dealerOrgId], references: [id], onDelete: Restrict)
  tradeLanes                OrganizationTradeLane[]
  brandRelationships        OrganizationBrandRelationship[]
  claimRequests             OrganizationDirectoryClaimRequest[]
  profileDraft              OrganizationDirectoryProfileDraft?

  @@index([status, orgType, publishedAt(sort: Desc)])
  @@index([headquartersCountryCode, status])
  @@index([claimStatus, status])
}

model OrganizationDirectoryClaimRequest {
  id                  String                                  @id @default(cuid())
  directoryEntryId    String
  applicantAccountId  String
  claimantDealerOrgId String
  reviewerAccountId   String?
  requestKey          String
  status              OrganizationDirectoryClaimRequestStatus @default(pending)
  evidenceKind        OrganizationDirectoryClaimEvidenceKind
  authorityRole       String
  businessEmail       String?
  evidenceUrl         String?
  evidenceSummary     String
  reviewReasonCode    String?
  reviewNote          String?
  version             Int                                     @default(1)
  submittedAt         DateTime                                @default(now())
  reviewedAt          DateTime?
  withdrawnAt         DateTime?
  createdAt           DateTime                                @default(now())
  updatedAt           DateTime                                @updatedAt
  directoryEntry      OrganizationDirectoryEntry              @relation(fields: [directoryEntryId], references: [id], onDelete: Restrict)
  applicantAccount    MarketplaceAccount                      @relation("DirectoryClaimApplicant", fields: [applicantAccountId], references: [id], onDelete: Restrict)
  claimantDealerOrg   DealerOrg                               @relation(fields: [claimantDealerOrgId], references: [id], onDelete: Restrict)
  reviewerAccount     MarketplaceAccount?                     @relation("DirectoryClaimReviewer", fields: [reviewerAccountId], references: [id], onDelete: Restrict)

  @@unique([applicantAccountId, requestKey], map: "OrganizationDirectoryClaimRequest_applicantAccountId_requestKey")
  @@index([status, submittedAt])
  @@index([directoryEntryId, status, submittedAt], map: "OrganizationDirectoryClaimRequest_directoryEntryId_status_submi")
  @@index([claimantDealerOrgId, status], map: "OrganizationDirectoryClaimRequest_claimantDealerOrgId_status_id")
  @@index([reviewerAccountId, reviewedAt], map: "OrganizationDirectoryClaimRequest_reviewerAccountId_reviewedAt_")
}

model OrganizationDirectoryProfileDraft {
  id                 String                     @id @default(cuid())
  directoryEntryId   String                     @unique
  payload            Json
  version            Int                        @default(1)
  updatedByAccountId String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  directoryEntry     OrganizationDirectoryEntry @relation(fields: [directoryEntryId], references: [id], onDelete: Cascade)
  updatedByAccount   MarketplaceAccount         @relation("DirectoryDraftUpdater", fields: [updatedByAccountId], references: [id], onDelete: Restrict)

  @@index([updatedByAccountId, updatedAt], map: "OrganizationDirectoryProfileDraft_updatedByAccountId_updatedAt_")
}

model OrganizationTradeLane {
  id                       String                     @id @default(cuid())
  directoryEntryId         String
  originCountryCode        String                     @db.Char(2)
  destinationCountryCode   String                     @db.Char(2)
  serviceKinds             String[]                   @default([])
  vehicleCategories        VehicleCategory[]          @default([])
  estimatedDeliveryMinDays Int?
  estimatedDeliveryMaxDays Int?
  active                   Boolean                    @default(true)
  lastConfirmedAt          DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  directoryEntry           OrganizationDirectoryEntry @relation(fields: [directoryEntryId], references: [id], onDelete: Cascade)

  @@unique([directoryEntryId, originCountryCode, destinationCountryCode], map: "OrganizationTradeLane_directoryEntryId_originCountryCode_destin")
  @@index([originCountryCode, destinationCountryCode, active], map: "OrganizationTradeLane_originCountryCode_destinationCountryCode_")
  @@index([destinationCountryCode, active])
}

model OrganizationBrandRelationship {
  id                String                            @id @default(cuid())
  directoryEntryId  String
  brandName         String
  relationshipType  OrganizationBrandRelationshipType
  marketCountryCode String?                           @db.Char(2)
  evidenceStatus    OrganizationEvidenceStatus        @default(self_reported)
  evidenceUrl       String?
  evidenceCheckedAt DateTime?
  verifiedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  directoryEntry    OrganizationDirectoryEntry        @relation(fields: [directoryEntryId], references: [id], onDelete: Cascade)

  @@unique([directoryEntryId, brandName, relationshipType, marketCountryCode], map: "OrganizationBrandRelationship_directoryEntryId_brandName_relati")
  /// Global (NULL-market) uniqueness is enforced by a partial index in the migration.
  @@index([brandName, relationshipType, evidenceStatus], map: "OrganizationBrandRelationship_brandName_relationshipType_eviden")
  @@index([marketCountryCode, evidenceStatus], map: "OrganizationBrandRelationship_marketCountryCode_evidenceStatus_")
}

model DealerMember {
  id                     String                    @id @default(cuid())
  dealerOrgId            String
  accountId              String
  clerkMembershipId      String?                   @unique
  clerkProviderUpdatedAt DateTime?
  clerkLastEventId       String?
  clerkDeletedAt         DateTime?
  clerkSourceRole        String?
  clerkLastSyncedAt      DateTime?
  disabledAt             DateTime?
  role                   DealerRole                @default(sales)
  status                 DealerMemberStatus        @default(active)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  dealerOrg              DealerOrg                 @relation(fields: [dealerOrgId], references: [id], onDelete: Restrict)
  account                MarketplaceAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  assignedLeads          Lead[]
  participants           ConversationParticipant[]

  @@unique([dealerOrgId, accountId])
  @@index([accountId, status])
  @@index([dealerOrgId, status, role])
  @@index([clerkProviderUpdatedAt])
}

model ClerkOrgProvisioning {
  id                   String                     @id @default(cuid())
  applicantAccountId   String
  requestKey           String
  requestedDisplayName String
  requestedOrgType     DealerOrgType
  requestedCountryCode String                     @db.Char(2)
  status               ClerkOrgProvisioningStatus @default(requested)
  clerkOrgId           String?                    @unique
  attemptCount         Int                        @default(0)
  nextAttemptAt        DateTime?
