{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./accounts": "./accounts.ts",
    "./auth-sync": "./auth-sync.ts",
    "./clerk-provisioning": "./clerk-provisioning.ts",
    "./commerce": "./commerce.ts",
    "./dealer-studio": "./dealer-studio.ts",
    "./inventory-health": "./inventory-health.ts",
    "./inventory-imports": "./inventory-imports.ts",
    "./inventory-ingestion": "./inventory-ingestion.ts",
    "./inventory-ordering": "./inventory-ordering.ts",
    "./inventory-sources": "./inventory-sources.ts",
    "./keys": "./keys.ts",
    "./kyb-documents": "./kyb-documents.ts",
    "./leads": "./leads.ts",
    "./listings": "./listings.ts",
    "./marketplace": "./marketplace.ts",
    "./media": "./media.ts",
    "./organization-access": "./organization-access.ts",
    "./organization-directory": "./organization-directory.ts",
    "./organization-profile": "./organization-profile.ts",
    "./organization-profile-claims": "./organization-profile-claims.ts",
    "./organization-verification": "./organization-verification.ts",
    "./organizations": "./organizations.ts",
    "./trusted-admin": "./trusted-admin.ts",
    "./trusted-directory-admin": "./trusted-directory-admin.ts",
    "./vehicle-taxonomy": "./vehicle-taxonomy.ts"
  },
  "scripts": {
    "analyze": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "build": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "migration:audit": "vitest run migration-release.test.ts",
    "migration:contract": "tsx scripts/migration-contract.ts --ignore-database-url",
    "migration:release": "tsx scripts/database-release.ts",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "7.4.2",
    "@prisma/client": "7.4.2",
    "@prisma/client-runtime-utils": "^7.4.2",
    "@repo/marketplace-domain": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.10",
    "server-only": "^0.0.1",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.4.2",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.3.5",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.1.0",
    "dotenv": "^16.5.0",
    "pg": "^8.22.0",
    "prisma": "7.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
