# Required launch intent (currently all provider-backed capabilities stay disabled)
AUTOMARKET_ENABLE_AUTH_RECOVERY="false"
AUTOMARKET_ENABLE_BILLING="false"
AUTOMARKET_ENABLE_EXTERNAL_INVENTORY="false"
AUTOMARKET_ENABLE_KYB_RETENTION="false"
AUTOMARKET_ENABLE_PRIVATE_IMPORTS="false"

# Local/pilot external inventory. Auto.dev currently supplies US dealer listings.
AUTO_DEV_API_KEY=""

# Launch-core server configuration
BLOB_READ_WRITE_TOKEN=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
CRON_SECRET=""
DATABASE_URL=""
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_URL=""

# Provider callbacks; set only with the matching configured adapter
INVENTORY_SCANNER_CALLBACK_SECRET=""
KYB_PROVIDER_CALLBACK_SECRET=""
KYB_SCANNER_CALLBACK_SECRET=""

# Read-only inventory credential bindings use env:AUTOMARKET_INVENTORY_* references.
# Each durable binding must supply the exact organization/source/purpose scope.
AUTOMARKET_INVENTORY_EXAMPLE_TOKEN=""

# Optional server integrations; configure complete provider groups or leave blank
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""
BETTER_STACK_INGESTING_URL=""
BETTER_STACK_SOURCE_TOKEN=""
RESEND_FROM=""
RESEND_TOKEN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cross-app origins (public values, but the API has no browser configuration)
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"

# Optional browser-visible analytics and Sentry ingestion configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_SENTRY_DSN=""
